#include <driver/i2s.h>
#include <math.h>

// Connections to INMP441 I2S microphone
#define I2S_WS  5
#define I2S_SD  18
#define I2S_SCK 4

// Output Pins for DB levels
#define PIN_LOW_NOISE  9   // 60 to 80 dB
#define PIN_HIGH_NOISE 8   // 80 to 120 dB (Combined 80-110 and 110-120)

#define I2S_PORT I2S_NUM_0
#define BUFFER_LEN  512
int32_t sBuffer[BUFFER_LEN];

void i2s_install() {
  const i2s_config_t i2s_config = {
    .mode                 = (i2s_mode_t)(I2S_MODE_MASTER | I2S_MODE_RX),
    .sample_rate          = 44100,
    .bits_per_sample      = I2S_BITS_PER_SAMPLE_32BIT,
    .channel_format       = I2S_CHANNEL_FMT_ONLY_LEFT,
    .communication_format = I2S_COMM_FORMAT_STAND_I2S,
    .intr_alloc_flags     = 0,
    .dma_buf_count        = 8,
    .dma_buf_len          = BUFFER_LEN,
    .use_apll             = false
  };
  i2s_driver_install(I2S_PORT, &i2s_config, 0, NULL);
}

void i2s_setpin() {
  const i2s_pin_config_t pin_config = {
    .bck_io_num   = I2S_SCK,
    .ws_io_num    = I2S_WS,
    .data_out_num = -1,
    .data_in_num  = I2S_SD
  };
  i2s_set_pin(I2S_PORT, &pin_config);
}

void setup() {
  Serial.begin(115200);
  
  // Initialize Output Pins
  pinMode(PIN_LOW_NOISE, OUTPUT);
  pinMode(PIN_HIGH_NOISE, OUTPUT);
  
  // Ensure they start LOW
  digitalWrite(PIN_LOW_NOISE, LOW);
  digitalWrite(PIN_HIGH_NOISE, LOW);

  delay(200);
  Serial.println("\n=== INMP441 Calibrated dB SPL Monitor ===");

  i2s_install();
  i2s_setpin();
  i2s_start(I2S_PORT);
  delay(500);
}

void loop() {
  size_t bytes_read = 0;
  esp_err_t res = i2s_read(I2S_PORT, sBuffer, BUFFER_LEN * sizeof(int32_t), &bytes_read, portMAX_DELAY);

  if (res == ESP_OK && bytes_read > 0) {
    int num_samples = bytes_read / sizeof(int32_t);
    float sum = 0.0f;
    float sum_sq = 0.0f;
    int count = 0;

    for (int i = 0; i < num_samples; i++) {
      int32_t raw = sBuffer[i] >> 8; 
      if (raw == 0 || raw == -1) continue;
      sum += (float)raw;
      count++;
    }

    float mean = (count > 0) ? sum / count : 0.0f;

    for (int i = 0; i < num_samples; i++) {
      int32_t raw = sBuffer[i] >> 8;
      float s = (float)raw - mean;
      sum_sq += s * s;
    }

    float rms = (count > 0) ? sqrtf(sum_sq / count) : 0.0f;
    float rms_norm = rms / 8388608.0f;
    float dBFS = (rms_norm > 1e-7f) ? 20.0f * log10f(rms_norm) : -120.0f;

    const float OFFSET = 120.0f; 
    float dBSPL = dBFS + OFFSET;

    // --- LOGIC FOR PINS ---
    // Reset pins first
    digitalWrite(PIN_LOW_NOISE, LOW);
    digitalWrite(PIN_HIGH_NOISE, LOW);

    if (dBSPL >= 60.0f && dBSPL < 80.0f) {
      digitalWrite(PIN_LOW_NOISE, HIGH);
    } 
    else if (dBSPL >= 80.0f && dBSPL <= 120.0f) {
      // Covers both 80-110 and 110-120 as per your request
      digitalWrite(PIN_HIGH_NOISE, HIGH);
    }

    // Print Data
    Serial.print("dB SPL: ");
    Serial.print(dBSPL, 1);
    Serial.println(" dB");

  } else {
    Serial.println("I2S read failed");
  }

  delay(500); // Reduced delay for better responsiveness
}
